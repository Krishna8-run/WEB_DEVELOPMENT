<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
</head>
<body>
    <h1>Instagram</h1>
    <h2>Welcome <%= username %> </h2>
    <button>Follow </button>
    <button>Message</button>
    <h2>Followers</h2>
    <% for(let name of followers){ %>
      <ul>
        <li><%= name %> </li> 
       </ul> 
    <% } %>
</body>
</html>