<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% if(dice==6){ %>
        <h2>Congratulations! You rolled a 6!</h2>
    <% } else { %>
        <h2>Better luck next time! You rolled a <%= dice %>.</h2>
    <% } %>
    <h2>Your dice value is <%= dice %> .</h2>
</body>
</html>